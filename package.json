{
  "name": "heartflow-aurora",
  "productName": "Heartflow Aurora",
  "version": "0.6.5",
  "private": true,
  "description": "A desktop AI companion with voice, desktop tools, a Solana trading workspace and a choice of model providers",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "vendor": "node scripts/vendor.js",
    "animations": "electron scripts/animations.js",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "clean:builds": "node scripts/clean-builds.js",
    "verify:release": "node scripts/verify-release.js"
  },
  "devDependencies": {
    "dompurify": "^3.4.16",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.1.3",
    "marked": "^18.0.14",
    "prismjs": "^1.30.0"
  },
  "build": {
    "asarUnpack": [
      "src/native/**/*"
    ],
    "appId": "ai.heartflow.aurora",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "src/assets/brand/heartflow.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance"
    },
    "nsis": {
      "artifactName": "Heartflow-Aurora-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "Aurora - Heartflow AI"
    },
    "publish": {
      "provider": "github",
      "owner": "HeartFlowAI",
      "repo": "hfai_harness_app",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@walletconnect/sign-client": "^2.26.0",
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "author": "Heartflow AI"
}
